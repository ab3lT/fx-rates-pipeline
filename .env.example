# Copy to .env and adjust. The pipeline reads these at startup.

# Database. Defaults to a local SQLite file so the pipeline runs with zero setup.
# For PostgreSQL use e.g. postgresql+psycopg2://fx:fx@localhost:5432/fx
FX_DATABASE_URL=sqlite:///fx.db

# Source API (Frankfurter, no key required)
FX_API_BASE_URL=https://api.frankfurter.app
FX_BASE_CURRENCY=USD
FX_SYMBOLS=EUR,GBP,JPY,CNY,ETB

# Resilience
FX_REQUEST_TIMEOUT=30
FX_MAX_RETRIES=4

# Logging: DEBUG, INFO, WARNING, ERROR
FX_LOG_LEVEL=INFO
