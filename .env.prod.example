# Production settings for docker-compose.prod.yml. Copy to .env.prod and edit.
# .env.prod is git-ignored; never commit real secrets.

POSTGRES_USER=fx
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=fx

# Quote currencies. Frankfurter serves ECB reference rates only, so currencies the
# ECB does not publish (for example ETB) are missing and trigger a quality warning.
FX_BASE_CURRENCY=USD
FX_SYMBOLS=EUR,GBP,JPY,CNY,CHF,CAD,AUD,INR

# Scheduler: run every N hours; backfill N days of history on first start.
FX_SCHEDULE_HOURS=6
FX_BACKFILL_DAYS=365

# Token for POST /api/runs (manual trigger). Leave empty to disable the endpoint.
# Generate one with: openssl rand -hex 32
FX_ADMIN_TOKEN=

FX_LOG_LEVEL=INFO

# Host port the dashboard binds to (on 127.0.0.1 only).
WEB_PORT=8000
